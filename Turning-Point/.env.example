# ==============================================================================
# EventInsight AI — Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.
# Never commit the .env file containing real secrets to Git.
# ==============================================================================

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=eventinsight_ai
MONGODB_EVENTS_COLLECTION=events

# Multi-Tenancy / Default Organization
DEFAULT_ORG_ID=org_turning_point_default
DEFAULT_ORG_NAME="Turning Point Apps Default"

# Source Feed Identifier
DEFAULT_SOURCE_ID=feed_synthetic_excel

# Ingestion Settings
INGESTION_BATCH_SIZE=100
LOG_LEVEL=INFO

# Solace PubSub+ Event Broker Configuration (Placeholders - put real values in .env)
SOLACE_HOST=tcps://your-solace-host.messaging.solace.cloud:55443
SOLACE_VPN=your-message-vpn
SOLACE_USERNAME=solace-cloud-client
SOLACE_PASSWORD=your-solace-password
SOLACE_TOPIC=eventinsight/events/>
SOLACE_QUEUE=

